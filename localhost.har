            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/src/components/Board.module.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"C:/Users/hp/OneDrive/Desktop/IITGN-CDF-main/src/components/Board.module.css\"\nconst __vite__css = \"/* ----------------------------------------------------\\n   PREMIUM CARD — GLASSMORPHISM VARIANT\\n----------------------------------------------------- */\\n\\n._premium-card_1xxyv_5 {\\n  position: relative;\\n  border-radius: 1.25rem;\\n  background: linear-gradient(\\n      135deg,\\n      rgba(255, 255, 255, 0.96),\\n      rgba(251, 251, 255, 0.9)\\n    ),\\n    rgba(255, 255, 255, 0.8);\\n  backdrop-filter: blur(10px);\\n  border: 1px solid rgba(99, 102, 241, 0.14);\\n  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);\\n  box-shadow:\\n    0 14px 30px rgba(15, 23, 42, 0.08),\\n    0 0 0 1px rgba(15, 23, 42, 0.02);\\n  padding: 4rem 1.5rem 1.5rem;\\n  overflow: visible;\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  width: 100%;\\n  max-width: 360px;\\n  height: auto;\\n  gap: 0.75rem;\\n}\\n\\n._premium-card_1xxyv_5::after {\\n  content: \\\"\\\";\\n  position: absolute;\\n  inset: 1px;\\n  border-radius: inherit;\\n  pointer-events: none;\\n  background: linear-gradient(\\n    135deg,\\n    rgba(99, 102, 241, 0.08),\\n    rgba(236, 72, 153, 0.08)\\n  );\\n  z-index: -1;\\n}\\n\\n._premium-card_1xxyv_5:hover {\\n  transform: translateY(-4px) scale(1.01);\\n  box-shadow:\\n    0 24px 55px rgba(15, 23, 42, 0.15),\\n    0 0 0 1px rgba(99, 102, 241, 0.08);\\n  border-color: rgba(99, 102, 241, 0.25);\\n}\\n\\n/* ----------------------------------------------------\\n   PREMIUM AVATAR\\n----------------------------------------------------- */\\n\\n._avatar-wrapper_1xxyv_58 {\\n  background: linear-gradient(\\n    135deg,\\n    rgba(255, 255, 255, 0.95),\\n    rgba(255, 255, 255, 0.7)\\n  );\\n  padding: 6px;\\n  border-radius: 50%;\\n  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18),\\n    0 0 14px rgba(255, 255, 255, 0.6) inset;\\n  transition: all 0.3s ease;\\n  flex-shrink: 0;\\n  overflow: hidden;\\n  width: -moz-fit-content;\\n  width: fit-content;\\n  height: -moz-fit-content;\\n  height: fit-content;\\n}\\n\\n._avatar-image_1xxyv_75 {\\n  width: 120px;\\n  height: 120px;\\n  -o-object-fit: cover;\\n     object-fit: cover;\\n  border-radius: 50%;\\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);\\n  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\\n  display: block;\\n}\\n\\n/* Make grid cells stretch to same height and center cards */\\n._board-grid_1xxyv_86 {\\n  align-items: start;\\n}\\n\\n@media (min-width: 768px) {\\n  ._premium-card_1xxyv_5 {\\n    max-width: 380px;\\n  }\\n}\\n\\n._premium-card_1xxyv_5:hover ._avatar-image_1xxyv_75 {\\n  transform: scale(1.08) rotate(2deg);\\n}\\n\\n._premium-card_1xxyv_5:hover ._avatar-wrapper_1xxyv_58 {\\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2),\\n    0 0 16px rgba(255, 255, 255, 0.7) inset;\\n}\\n\\n/* ----------------------------------------------------\\n   TEXT STYLING\\n----------------------------------------------------- */\\n\\n._premium-name_1xxyv_109 {\\n  font-size: 1.2rem;\\n  font-weight: 700;\\n  line-height: 1.2;\\n  letter-spacing: -0.3px;\\n  color: #0f172a;\\n  text-align: center;\\n  white-space: normal;\\n  max-width: 90%;\\n}\\n\\n._premium-title_1xxyv_120 {\\n  width: 100%;\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  gap: 0.35rem;\\n  margin-bottom: 1.2rem;\\n  padding: 0 0.25rem;\\n}\\n\\n._premium-title_1xxyv_120 span {\\n  font-size: 0.82rem;\\n  font-weight: 600;\\n  color: #4338ca;\\n  background: rgba(99, 102, 241, 0.08);\\n  padding: 0.35rem 0.75rem;\\n  border-radius: 999px;\\n  text-align: center;\\n  width: -moz-fit-content;\\n  width: fit-content;\\n  max-width: 100%;\\n  line-height: 1.35;\\n  word-break: break-word;\\n}\\n\\n._premium-intro_1xxyv_144 {\\n  font-size: 0.9rem;\\n  color: #777777;\\n  line-height: 1.6;\\n  margin-bottom: 1rem;\\n  max-width: 95%;\\n  margin-left: auto;\\n  margin-right: auto;\\n  text-align: center;\\n  padding: 0 0.25rem;\\n}\\n\\n._premium-bio_1xxyv_156 {\\n  font-size: 0.9rem;\\n  color: #475569;\\n  line-height: 1.6;\\n  margin-bottom: 1rem;\\n  max-width: 95%;\\n  margin-left: auto;\\n  margin-right: auto;\\n  text-align: left;\\n  padding: 0 0.25rem;\\n}\\n\\n/* ----------------------------------------------------\\n   LINKEDIN BUTTON\\n----------------------------------------------------- */\\n\\n._linkedin-button_1xxyv_172 {\\n  width: 36px;\\n  height: 36px;\\n  border-radius: 999px;\\n  background: linear-gradient(\\n    135deg,\\n    rgba(var(--primary-rgb), 0.15),\\n    rgba(var(--primary-rgb), 0.05)\\n  );\\n  color: var(--primary);\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\\n  backdrop-filter: blur(8px);\\n  border: 1px solid rgba(var(--primary-rgb), 0.2);\\n}\\n\\n._linkedin-button_1xxyv_172:hover {\\n  /* Keep a soft background, but make the icon itself the primary/accent color */\\n  background: rgba(var(--primary-rgb), 0.12);\\n  color: var(--primary);\\n  box-shadow: 0 6px 16px rgba(var(--primary-rgb), 0.12);\\n  transform: translateY(-2px) scale(1.03);\\n  border-color: rgba(var(--primary-rgb), 0.18);\\n}\\n\\n/* ----------------------------------------------------\\n   TOGGLE BUTTON\\n----------------------------------------------------- */\\n\\n._premium-toggle_1xxyv_204 {\\n  font-size: 0.85rem;\\n  color: var(--primary);\\n  font-weight: 600;\\n  cursor: pointer;\\n  padding: 0.5rem 1rem;\\n  margin-top: 0.5rem;\\n  transition: all 0.25s ease;\\n  border-radius: 0.5rem;\\n  background: rgba(var(--primary-rgb), 0.08);\\n  border: none;\\n}\\n\\n._premium-toggle_1xxyv_204:hover {\\n  background: rgba(var(--primary-rgb), 0.15);\\n  color: var(--primary);\\n  transform: translateY(-1px);\\n  box-shadow: 0 2px 8px rgba(var(--primary-rgb), 0.2);\\n}\\n\\n/* ----------------------------------------------------\\n   ANIMATION DELAYS\\n----------------------------------------------------- */\\n._delay-0_1xxyv_227 {\\n  animation-delay: 0ms;\\n}\\n._delay-100_1xxyv_230 {\\n  animation-delay: 100ms;\\n}\\n._delay-200_1xxyv_233 {\\n  animation-delay: 200ms;\\n}\\n._delay-300_1xxyv_236 {\\n  animation-delay: 300ms;\\n}\\n._delay-400_1xxyv_239 {\\n  animation-delay: 400ms;\\n}\\n._delay-500_1xxyv_242 {\\n  animation-delay: 500ms;\\n}\\n._delay-600_1xxyv_245 {\\n  animation-delay: 600ms;\\n}\\n._delay-700_1xxyv_248 {\\n  animation-delay: 700ms;\\n}\\n._delay-800_1xxyv_251 {\\n  animation-delay: 800ms;\\n}\\n._delay-900_1xxyv_254 {\\n  animation-delay: 900ms;\\n}\\n\\n/* Center lone last card in the grid so 7th item appears centered */\\n@media (min-width: 768px) {\\n  ._board-grid_1xxyv_86 > :last-child {\\n    grid-column: 1 / -1;\\n    justify-self: center;\\n    align-self: start;\\n  }\\n}\\n\"\n__vite__updateStyle(__vite__id, __vite__css)\nexport default {\n\t\"premium-card\": \"_premium-card_1xxyv_5\",\n\t\"avatar-wrapper\": \"_avatar-wrapper_1xxyv_58\",\n\t\"avatar-image\": \"_avatar-image_1xxyv_75\",\n\t\"board-grid\": \"_board-grid_1xxyv_86\",\n\t\"premium-name\": \"_premium-name_1xxyv_109\",\n\t\"premium-title\": \"_premium-title_1xxyv_120\",\n\t\"premium-intro\": \"_premium-intro_1xxyv_144\",\n\t\"premium-bio\": \"_premium-bio_1xxyv_156\",\n\t\"linkedin-button\": \"_linkedin-button_1xxyv_172\",\n\t\"premium-toggle\": \"_premium-toggle_1xxyv_204\",\n\t\"delay-0\": \"_delay-0_1xxyv_227\",\n\t\"delay-100\": \"_delay-100_1xxyv_230\",\n\t\"delay-200\": \"_delay-200_1xxyv_233\",\n\t\"delay-300\": \"_delay-300_1xxyv_236\",\n\t\"delay-400\": \"_delay-400_1xxyv_239\",\n\t\"delay-500\": \"_delay-500_1xxyv_242\",\n\t\"delay-600\": \"_delay-600_1xxyv_245\",\